diff --git a/drivers/tty/hvc/hvc_jailhouse.c b/drivers/tty/hvc/hvc_jailhouse.c
new file mode 100644
index 000000000..e5159fe4c
--- /dev/null
+++ b/drivers/tty/hvc/hvc_jailhouse.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Console for Linux running in a Jailhouse non-root cell (arm64): every
+ * character goes through the hypervisor's debug-console hypercall and shows
+ * up in "jailhouse console" in the root cell. Output only, no input. The cell
+ * needs JAILHOUSE_CELL_VIRTUAL_CONSOLE_PERMITTED; "earlycon=jailhouse" covers
+ * the boot until the hvc console (/dev/hvc0, console=hvc0) takes over.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/serial_core.h>
+
+#include "hvc_console.h"
+
+#define JAILHOUSE_HVC_IMM		"0x4a48"
+#define JAILHOUSE_HC_DEBUG_CONSOLE_PUTC	8
+
+static void jailhouse_putc(char c)
+{
+	register unsigned long x0 asm("x0") = JAILHOUSE_HC_DEBUG_CONSOLE_PUTC;
+	register unsigned long x1 asm("x1") = (unsigned char)c;
+
+	asm volatile("hvc #" JAILHOUSE_HVC_IMM
+		     : "+r" (x0) : "r" (x1) : "memory");
+}
+
+static void jailhouse_early_write(struct console *con, const char *s,
+				  unsigned int n)
+{
+	while (n--)
+		jailhouse_putc(*s++);
+}
+
+static int __init jailhouse_early_console_setup(struct earlycon_device *device,
+						const char *opt)
+{
+	device->con->write = jailhouse_early_write;
+	return 0;
+}
+EARLYCON_DECLARE(jailhouse, jailhouse_early_console_setup);
+
+static int hvc_jailhouse_put_chars(uint32_t vt, const char *buf, int count)
+{
+	int i;
+
+	for (i = 0; i < count; i++)
+		jailhouse_putc(buf[i]);
+	return count;
+}
+
+static int hvc_jailhouse_get_chars(uint32_t vt, char *buf, int count)
+{
+	return 0;
+}
+
+static const struct hv_ops hvc_jailhouse_ops = {
+	.get_chars = hvc_jailhouse_get_chars,
+	.put_chars = hvc_jailhouse_put_chars,
+};
+
+static bool in_jailhouse_cell(void)
+{
+	struct device_node *np = of_find_compatible_node(NULL, NULL,
+							 "jailhouse,cell");
+
+	of_node_put(np);
+	return np != NULL;
+}
+
+static int __init hvc_jailhouse_console_init(void)
+{
+	if (!in_jailhouse_cell())
+		return -ENODEV;
+	return hvc_instantiate(0, 0, &hvc_jailhouse_ops) < 0 ? -ENODEV : 0;
+}
+console_initcall(hvc_jailhouse_console_init);
+
+static int __init hvc_jailhouse_init(void)
+{
+	if (!in_jailhouse_cell())
+		return -ENODEV;
+	return PTR_ERR_OR_ZERO(hvc_alloc(0, 0, &hvc_jailhouse_ops, 128));
+}
+device_initcall(hvc_jailhouse_init);
