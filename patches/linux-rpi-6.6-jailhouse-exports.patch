 					       ioremap_max_page_shift);
 	return err;
 }
+EXPORT_SYMBOL_GPL(ioremap_page_range); /* Jailhouse */
+
+/*
+ * Jailhouse: ioremap_page_range() forces NX, but the driver maps the
+ * hypervisor image and jumps into it, so it needs the caller's prot as-is.
+ */
+int ioremap_page_range_exec(unsigned long addr, unsigned long end,
+		phys_addr_t phys_addr, pgprot_t prot)
+{
+	int err;
+
+	err = vmap_range_noflush(addr, end, phys_addr, prot,
+				 ioremap_max_page_shift);
+	flush_cache_vmap(addr, end);
+	return err;
+}
+EXPORT_SYMBOL_GPL(ioremap_page_range_exec);
 
